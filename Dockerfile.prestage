FROM golang:1.24-alpine AS builder

ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /src
RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/shop_server ./cmd

FROM alpine:3.20

WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata wget

COPY --from=builder /out/shop_server /app/shop_server

ENV TZ=Asia/Shanghai
EXPOSE 8080
ENTRYPOINT ["/app/shop_server"]
